{
  "bsonType": "object",
  "required": ["request_id", "user_id", "title", "status", "created_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "Event ID"
    },
    "request_id": {
      "bsonType": "string",
      "description": "Frontend request ID for one AI turn"
    },
    "session_id": {
      "bsonType": "string",
      "description": "chat_sessions._id"
    },
    "user_id": {
      "bsonType": "string",
      "description": "Owner user ID"
    },
    "scene": {
      "bsonType": "string",
      "description": "Chat scene"
    },
    "event_type": {
      "bsonType": "string",
      "description": "Coze event or message type"
    },
    "title": {
      "bsonType": "string"
    },
    "content": {
      "bsonType": "string"
    },
    "status": {
      "bsonType": "string",
      "enum": ["running", "done", "error"],
      "defaultValue": "running"
    },
    "raw_event": {
      "bsonType": "object",
      "description": "Small raw metadata for troubleshooting"
    },
    "created_at": {
      "bsonType": "timestamp",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  },
  "index": [
    {
      "IndexName": "idx_request_created",
      "MgoKeySchema": {
        "request_id": 1,
        "created_at": 1
      }
    },
    {
      "IndexName": "idx_user_request_created",
      "MgoKeySchema": {
        "user_id": 1,
        "request_id": 1,
        "created_at": 1
      }
    }
  ]
}
