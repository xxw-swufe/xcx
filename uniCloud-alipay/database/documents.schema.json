{
  "bsonType": "object",
  "required": ["user_id", "title", "file_name", "file_url", "file_type", "status", "created_at", "updated_at"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "Document ID"
    },
    "user_id": {
      "bsonType": "string",
      "description": "users._id"
    },
    "project_id": {
      "bsonType": "string",
      "description": "Reserved project ID"
    },
    "category": {
      "bsonType": "string",
      "description": "Document category"
    },
    "title": {
      "bsonType": "string"
    },
    "file_name": {
      "bsonType": "string"
    },
    "file_url": {
      "bsonType": "string"
    },
    "file_type": {
      "bsonType": "string",
      "enum": ["pdf", "doc", "docx", "jpg", "png", "other"]
    },
    "file_size": {
      "bsonType": "int",
      "description": "File size in bytes"
    },
    "status": {
      "bsonType": "string",
      "enum": ["pending", "processing", "approved", "rejected", "deleted"],
      "defaultValue": "pending"
    },
    "ai_summary": {
      "bsonType": "string",
      "description": "Reserved AI-generated summary"
    },
    "remark": {
      "bsonType": "string"
    },
    "created_at": {
      "bsonType": "timestamp",
      "forceDefaultValue": {
        "$env": "now"
      }
    },
    "updated_at": {
      "bsonType": "timestamp",
      "forceDefaultValue": {
        "$env": "now"
      }
    }
  },
  "index": [
    {
      "IndexName": "idx_user_created",
      "MgoKeySchema": {
        "user_id": 1,
        "created_at": -1
      }
    },
    {
      "IndexName": "idx_status",
      "MgoKeySchema": {
        "status": 1
      }
    }
  ]
}
